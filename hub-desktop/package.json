{
  "name": "@yibeibankaishui/archloop-hub-desktop",
  "version": "0.0.1",
  "private": true,
  "description": "archLoop Hub desktop control plane",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "predev": "npm --prefix .. run build",
    "dev": "npm run build:electron && concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "prebuild": "npm --prefix .. run build",
    "build": "vite build && npm run build:electron",
    "build:electron": "tsc -p tsconfig.electron.json",
    "preview": "npm run build && electron .",
    "pretypecheck": "npm --prefix .. run build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "install:ci": "npm ci",
    "audit:critical": "npm audit --audit-level=critical"
  },
  "dependencies": {
    "@yibeibankaishui/archloop": "file:..",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "cross-env": "^7.0.3",
    "electron": "^41.7.1",
    "typescript": "^5.8.0",
    "vite": "^6.3.5",
    "wait-on": "^8.0.4"
  }
}
