{
  "name": "@yibeibankaishui/archloop",
  "version": "0.5.9",
  "description": "CLI for orchestrating AI agents in isolated sandbox environments",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./sandboxes/docker": {
      "import": "./dist/sandboxes/docker.js",
      "types": "./dist/sandboxes/docker.d.ts"
    },
    "./sandboxes/vercel": {
      "import": "./dist/sandboxes/vercel.js",
      "types": "./dist/sandboxes/vercel.d.ts"
    },
    "./sandboxes/podman": {
      "import": "./dist/sandboxes/podman.js",
      "types": "./dist/sandboxes/podman.d.ts"
    },
    "./sandboxes/daytona": {
      "import": "./dist/sandboxes/daytona.js",
      "types": "./dist/sandboxes/daytona.d.ts"
    },
    "./sandboxes/no-sandbox": {
      "import": "./dist/sandboxes/no-sandbox.js",
      "types": "./dist/sandboxes/no-sandbox.d.ts"
    },
    "./hub-runtime-bridge": {
      "import": "./dist/hubRuntimeBridgeService.js",
      "types": "./dist/hubRuntimeBridgeService.d.ts"
    },
    "./hub-runtime-contract": {
      "import": "./dist/hubRuntimeBridge.js",
      "types": "./dist/hubRuntimeBridge.d.ts"
    },
    "./hub-desktop-shell": {
      "import": "./dist/hubDesktopShell.js",
      "types": "./dist/hubDesktopShell.d.ts"
    },
    "./hub-project-overview": {
      "import": "./dist/hubProjectOverview.js",
      "types": "./dist/hubProjectOverview.d.ts"
    },
    "./hub-run-workbench": {
      "import": "./dist/hubRunWorkbench.js",
      "types": "./dist/hubRunWorkbench.d.ts"
    },
    "./hub-proposal-workbench": {
      "import": "./dist/hubProposalWorkbench.js",
      "types": "./dist/hubProposalWorkbench.d.ts"
    }
  },
  "bin": {
    "archloop": "dist/main.js"
  },
  "scripts": {
    "build": "tsgo --project tsconfig.build.json",
    "postbuild": "rm -rf dist/templates dist/preset-bundles dist/capability-bundles dist/hub-flows && cp -r src/templates dist/templates && cp -r src/preset-bundles dist/preset-bundles && cp -r src/capability-bundles dist/capability-bundles && cp -r src/hub-flows dist/hub-flows",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsgo --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "release": "changeset publish",
    "archloop": "npm run build && tsx .archloop/main.ts",
    "test-podman": "npm run build && tsx --env-file=old_archloop/.env old_archloop/test-podman.ts",
    "test-vercel": "npm run build && tsx --env-file=old_archloop/.env old_archloop/test-vercel.ts",
    "test-interactive": "npm run build && tsx --env-file=old_archloop/.env old_archloop/test-interactive.ts"
  },
  "keywords": [
    "cli",
    "sandbox",
    "docker",
    "ai",
    "agent"
  ],
  "packageManager": "npm@10.9.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/Yibeibankaishui/archLoop"
  },
  "license": "MIT",
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@effect/vitest": "^0.28.0",
    "@types/node": "^25.5.0",
    "@typescript/native-preview": "^7.0.0-dev.20260317.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.1",
    "prettier": "^3.5.3",
    "tsx": "^4.21.0",
    "vitest": "^3.2.0",
    "@yibeibankaishui/archloop": "file:."
  },
  "dependencies": {
    "@beads/bd": "1.0.4",
    "@clack/prompts": "^1.1.0",
    "@effect/cli": "^0.74.0",
    "@effect/platform": "^0.95.0",
    "@effect/platform-node": "^0.105.0",
    "@effect/printer": "^0.48.0",
    "@effect/printer-ansi": "^0.48.0",
    "effect": "^3.20.0"
  },
  "peerDependencies": {
    "@vercel/sandbox": ">=1.0.0",
    "@daytona/sdk": "^0.164.0"
  },
  "peerDependenciesMeta": {
    "@vercel/sandbox": {
      "optional": true
    },
    "@daytona/sdk": {
      "optional": true
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md}": "prettier --write"
  },
  "files": [
    "dist"
  ]
}
